# ----------------------------------------------------------------------------
# INNOVEXA DIGITAL — environment variables
# Copy this file to `.env.local` for local development, and set the same keys
# in Vercel → Project → Settings → Environment Variables for production.
# NEXT_PUBLIC_* values are exposed to the browser; all others stay server-side only.
# ----------------------------------------------------------------------------

# Canonical production site URL (no trailing slash).
# Used for metadata, Open Graph, canonical tags, robots.txt and sitemap.xml.
# On Vercel you can leave this unset and the production deployment URL is used.
NEXT_PUBLIC_SITE_URL=https://innovexadigital.in

# Google Search Console verification token (the content="..." value of the
# google-site-verification meta tag). Lets the site auto-emit the verification tag.
# Optional — you can also verify via DNS or the uploaded HTML file method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form -> Google Sheet. Paste the Google Apps Script Web App URL (the /exec URL)
# that appends each submission as a row. Server-side only (NOT exposed to the browser).
# See docs/google-sheets-setup.md for the one-time setup.
GOOGLE_SHEET_WEBHOOK_URL=
